PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mernsm
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# There is no register page. The first admin is created from these on startup
# (only when the database has no admin yet). Remove ADMIN_PASSWORD afterwards.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
CLIENT_URL=http://localhost:5173
