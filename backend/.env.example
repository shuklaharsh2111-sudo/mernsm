PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mernsm
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# There is no register page. The first admin is created from these on startup
# (only when the database has no admin yet). Remove ADMIN_PASSWORD afterwards.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
CLIENT_URL=http://localhost:5173

# ---- Office-only login + attendance ----
# Centre of the office (get it from Google Maps: right-click the building -> copy coordinates)
OFFICE_LAT=19.0760
OFFICE_LNG=72.8777
# Allowed distance from the centre, in metres
OFFICE_RADIUS_METERS=200
# SMEs can only log in from the office (set to false to switch the check off)
ATTENDANCE_ENFORCE=true
# Admins are exempt by default so they can never be locked out; set true to restrict them too
ATTENDANCE_ENFORCE_ADMIN=false

# ---- Grain meeting recordings (Google Meet) ----
# Personal or Workspace access token: https://grain.com/app/settings/integrations?tab=api
GRAIN_API_TOKEN=
# Public-Api-Version header (see https://developers.grain.com/versions.html)
GRAIN_API_VERSION=2026-10-01
# How often the server checks Grain for finished recordings (ms, minimum 60000)
GRAIN_POLL_INTERVAL_MS=120000

# ---- Google Calendar (creates the Meet link as a calendar event so Grain can record it) ----
# Use the Google account that Grain is connected to. Get the refresh token with:  node scripts/google-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to put events on ("primary" = that account's default calendar)
GOOGLE_CALENDAR_ID=primary
# Timezone the meeting times are entered in, and default length
MEETING_TZ=Asia/Kolkata
MEETING_DURATION_MIN=60

# ---- Per-person Grain/Google accounts ----
# Each admin/SME connects their own Grain token and Google Calendar in Settings. Until then (or for testing),
# everyone can share the single account configured above (GRAIN_API_TOKEN + GOOGLE_REFRESH_TOKEN).
# Set to false once everyone has connected their own.
GRAIN_USE_DEFAULT_ACCOUNT=true
# Email of the shared test account (shown in Settings)
GRAIN_DEFAULT_ACCOUNT_EMAIL=
# Optional: separate key for encrypting stored tokens (defaults to JWT_SECRET)
GRAIN_ENCRYPTION_KEY=
# Google "Connect calendar" button: the OAuth client must be a Web application with this redirect URI registered
PUBLIC_API_URL=http://localhost:5000
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
